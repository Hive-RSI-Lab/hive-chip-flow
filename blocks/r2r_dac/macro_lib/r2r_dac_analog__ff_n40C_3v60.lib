/* macrolib (ngspice): r2r_dac_analog at ff_n40C_3v60, 3.6 V, -40 C, process ff, schematic netlist. Timing and input capacitance only. */
library(r2r_dac_analog__ff_n40C_3v60) {
  delay_model : table_lookup ;
  library_features(report_delay_calculation, report_power_calculation);
  time_unit : 1ns ;
  voltage_unit : 1V ;
  current_unit : 1mA ;
  capacitive_load_unit(1, pf);
  pulling_resistance_unit : 1ohm ;
  leakage_power_unit : 1uW ;
  input_threshold_pct_fall : 50 ;
  input_threshold_pct_rise : 50 ;
  output_threshold_pct_fall : 50 ;
  output_threshold_pct_rise : 50 ;
  slew_derate_from_library : 0.5 ;
  slew_lower_threshold_pct_fall : 30 ;
  slew_lower_threshold_pct_rise : 30 ;
  slew_upper_threshold_pct_fall : 70 ;
  slew_upper_threshold_pct_rise : 70 ;
  default_fanout_load : 1.0000000000 ;
  nom_process : 1 ;
  nom_temperature : -40 ;
  nom_voltage : 3.6 ;
  voltage_map(VNW, 3.6);
  voltage_map(VDD, 3.6);
  voltage_map(VSS, 0);
  voltage_map(VPW, 0);
  operating_conditions(r2r_dac_analog__ff_n40C_3v60) {
    process : 1 ;
    temperature : -40 ;
    voltage : 3.6 ;
  }
  input_voltage(default) {
    vil : 0 ;
    vih : 3.6 ;
    vimin : 0 ;
    vimax : 3.6 ;
  }
  output_voltage(default) {
    vol : 0 ;
    voh : 3.6 ;
    vomin : 0 ;
    vomax : 3.6 ;
  }
  lu_table_template (macro_slew_load) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("1, 2");
    index_2 ("1, 2, 3");
  }
  lu_table_template (macro_load) {
    variable_1 : total_output_net_capacitance;
    index_1 ("1, 2, 3");
  }
  type (macro_bus_dac_code) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
    downto : true;
  }
  cell (r2r_dac_analog) {
    is_macro_cell : true;
    bus (dac_code) {
      bus_type : macro_bus_dac_code;
      direction : input;
    pin ("dac_code[7]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[6]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[5]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[4]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[3]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[2]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[1]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    pin ("dac_code[0]") {
      direction : input;
      capacitance : 0.031899;
      rise_capacitance : 0.031898;
      fall_capacitance : 0.031899;
      max_transition : 3;
    }
    }
    pin ("vout") {
