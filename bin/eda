#!/usr/bin/env bash
# eda -- run a tool from an unpacked IIC-OSIC-TOOLS image tree, unprivileged,
# no docker, no root, no nested user namespaces.
#
#   eda <tool> [args...]
#
# APPROACH (generated shim directory + env overrides; no shebang rewriting
# into a persistent cache -- everything below is rebuilt fresh, per run,
# under mktemp, so more than one $EDA_TOOLCHAIN version can be in flight on
# the same box with nothing stale left behind):
#
#  * Every real binary under the tree is an Ubuntu 24.04 ELF built against
#    glibc 2.39. This host's own /lib64/ld-linux-x86-64.so.2 is glibc 2.43,
#    and the two do not mix: a plain `execve()` of an image binary dies with
#    "symbol lookup error ... GLIBC_PRIVATE" the moment it touches an image
#    .so alongside a host-loaded libc. So *every* exec of an image ELF -
#    ours, or one a tool spawns on its own - goes through the image's own
#    loader, `$T/lib64/ld-linux-x86-64.so.2 --library-path ...`, never the
#    kernel's default PT_INTERP resolution.
#
#  * That fixes direct invocation. The hard part named in the brief - a tool
#    that execs another by *name* - is fixed by a generated shim directory
#    placed first on PATH for the lifetime of the run: each entry is a tiny
#    wrapper script with the tool's bare name that re-execs the real binary
#    through the loader above. A wrapper is a *script* (not a copy of the
#    ELF), so this needs no patchelf and never touches the read-only tree.
#
#  * GCC's cc1/cc1plus/collect2/as/ld are not found via PATH at all - gcc's
#    own driver resolves them itself, relative to its own invoked path, and
#    only respects an externally supplied `-B<dir>` for redirecting that
#    (COMPILER_PATH was tried and does not move cc1plus's resolution; -B
#    does, empirically, and first). So the gcc/g++ wrappers in the shim dir
#    inject `-B$SHIM`, and the shim dir also holds wrapped copies of those
#    four names, again as loader-wrapping scripts. This is what makes g++ ->
#    cc1plus -> as -> ld work for Verilator's --binary C++ build.
#
#  * Verilator's own `verilator` front end is a Perl script that locates its
#    sibling `verilator_bin` and `share/verilator` by the *directory of its
#    own invoked path* (Perl FindBin, realpath-resolved) - a bare PATH shim
#    cannot redirect that, because the script would still compute the real,
#    read-only tree as its root. So it gets a small *mirror* instead: the
#    Perl script is copied byte for byte into a shim subdirectory (a copy,
#    not a symlink, so FindBin's realpath lands on our directory and not the
#    original), `verilator_bin`/`verilator_bin_dbg` become loader-wrapping
#    scripts alongside it, and `share`/`include` are whole-directory symlinks
#    back to the real tree (their contents need no fixing, only their path).
#
#  * magic and netgen ship a thin bash "wish replacement" wrapper whose
#    fallback TCL_MAG_DIR is a literal `/foss/tools/...` string, and whose
#    startup Tcl (magic.tcl / netgen.tcl) does `load /foss/tools/.../tcl*.so`
#    with the same literal prefix baked in. Rather than run those wrappers,
#    `eda` talks to the Tcl extension directly: it feeds the batch binary
#    (magicdnull / netgenexec) a small stdin script that does the one `load`
#    the wrapper would have done, with the prefix rewritten to $T, and then
#    calls the tool's own namespaced commands. This sidesteps the wrapper
#    entirely rather than patching it.
#
#  * Every script under usr/local/bin (librelane, sby's neighbours, etc.) is
#    a pip/uv console-script with an *absolute* `#!/usr/bin/python3` shebang
#    - literally the case named in the brief. The host has its own
#    /usr/bin/python3 with none of these packages installed, so the shebang
#    is bypassed outright: `eda` hands the script path to the image's own
#    python3.12 directly (`$LD ... python3.12 <script> "$@"`), never lets
#    the kernel read the shebang line. Scripts that instead say
#    `#!/usr/bin/env python3` do not need this - `env` does its own PATH
#    search, and the shim dir's own `python3` entry is what it finds.
#
#  * One consequence of "every exec goes through the image loader": a tool
#    is never itself execve()'d (ld.so is, and loads the tool without a
#    further execve), so /proc/self/exe keeps pointing at ld.so, not the
#    tool. Most of the tree doesn't care, but yosys calls
#    readlink("/proc/self/exe") itself to find its share/ directory, and
#    fails outright without it. Fixed with a small LD_PRELOAD shim
#    (fakeexe_so, below) that intercepts exactly that one readlink() and
#    answers with the tool's real path - source-built with the image's own
#    gcc at run time rather than vendoring a prebuilt patchelf (the more
#    conventional fix, and the one that was tried first) into the repo.
#
# $EDA_TOOLCHAIN picks the image tree; defaults to the one this box has at
# the path below. A second version can be used at any time by pointing a
# different invocation at it - nothing here is tied to one tree.

set -euo pipefail

EDA_SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# The repo this launcher lives in (bin/eda -> repo root), so `check-env`
# below can find its sibling script without a second copy of this path
# logic anywhere else.
EDA_REPO_ROOT="$(cd "$(dirname "$EDA_SELF")/.." && pwd)"
CHECK_ENV_PY="$EDA_REPO_ROOT/engine/scripts/check_env.py"

# $HOME/.cc/toolchains/iic-osic-tools-2026.09 is the box's own default, and
# this is the ONE place it is spelled out - docs/design.md and tests/
# check.sh both ask `eda --print-toolchain-root` for the resolved path
# below rather than carrying their own copy of the fallback that could go
# stale independently of this one.
T="${EDA_TOOLCHAIN:-$HOME/.cc/toolchains/iic-osic-tools-2026.09}"
if [ ! -d "$T" ]; then
  echo "eda: no toolchain tree at '$T' (set EDA_TOOLCHAIN)" >&2
  exit 1
fi
if [ "${1:-}" = "--print-toolchain-root" ]; then
  echo "$T"
  exit 0
fi

GCC_VER=13
LD="$T/lib64/ld-linux-x86-64.so.2"
BASE_LIBPATH="$T/lib/x86_64-linux-gnu:$T/usr/lib/x86_64-linux-gnu:$T/usr/lib/gcc/x86_64-linux-gnu/$GCC_VER:$T/usr/lib:$T/opt/or-tools/lib"
PYBIN="$T/usr/bin/python3.12"
PY_SITE="$T/usr/local/lib/python3.12/dist-packages"
PY_HOME="$T/usr"
# Exported globally, not just for run_py/wrap_py: several tools (yosys among
# them) link libpython and call Py_Initialize() themselves, unconditionally,
# whether or not the run actually touches a Python feature. Without
# PYTHONHOME, CPython's own fallback landmark search walks $PATH looking for
# a program named "python3" to derive its prefix from -- and since this
# launcher puts one there (for sby/yosys-smtbmc's `#!/usr/bin/env python3`),
# that search finds *our wrapper script*, not the real interpreter, and
# resolves the stdlib to nothing. Setting PYTHONHOME once, up front, is what
# makes an embedded interpreter agree with a spawned one.
export PYTHONHOME="$PY_HOME"

if [ $# -lt 1 ]; then
  echo "usage: eda <tool> [args...]" >&2
  exit 1
fi
TOOL="$1"; shift

# The shim directory used to be `mktemp -d`, rebuilt from scratch on every
# invocation and cleaned up by an EXIT trap. Two problems with that once a
# whole flow is calling `eda` per step, thousands of times a run: the trap
# never actually fires, because every case below ends in `exec` -- that
# replaces the process, so bash's own EXIT handling never runs, and each of
# those temp dirs is left behind for good (dozens of them were already
# sitting in /tmp). And rebuilding it every time re-does real work each
# call: a gcc invocation to compile the fakeexe.so shim, a copy of
# verilator's driver script, a handful of small files.
#
# So it's a cache instead: one shim directory per (toolchain path, image
# version, this script's own content) under
# ${XDG_CACHE_HOME:-~/.cache}/chip-flow/shims/<hash>, built once and then
# just reused -- reading $SHIM/<name> costs nothing close to writing it.
# Editing this script or pointing at a different image produces a
# different hash, so nothing stale is ever read back; nothing here deletes
# an old hash's directory, but nothing reads one either, so an orphaned
# entry is inert, not wrong. Built atomically for the case where two `eda`
# calls race on the very first, cold invocation: each builds its own
# private temp directory under the same cache root (same filesystem, so
# the rename below is a real rename, not a copy) and only one of the two
# `mv -T` calls can win, because POSIX rename() onto an existing
# *non-empty* directory fails rather than merging -- the loser just
# deletes its own copy and uses the winner's.
# WHERE the cache root lives is itself a security choice, not just a path.
# This box's worker sandboxes (cc-sandbox, a sibling project) bind the
# HOST's real ~/.cache read-write into every track worker -- that is where
# ~/.npm and other package caches persist across a worker's runs -- so a
# cache under ~/.cache is one a worker running a FOREIGN PR can write into.
# The librelane case below and wrap_recurse write actual shim SCRIPTS into
# this cache (magic/netgen/klayout wrappers that re-exec through this same
# launcher): a shim planted by a worker there is a shim a later, unsandboxed
# HOST run would exec, unmodified, no privilege check possible after the
# fact. A manifest recorded beside the cache would not fix this -- the same
# writer that can plant a shim can rewrite a manifest describing it as
# clean. So: CC_WORKER_SANDBOX=1 or CC_MEMBER_SANDBOX=1 (set by cc-sandbox
# on every sandboxed launch, never unset before exec) means this process IS
# the sandbox that owns whatever ~/.cache resolves to in here (a member's
# ~/.cache is already its own private directory, never the host's, but the
# same env check draws the line the same way for both rather than special-
# casing) -- ~/.cache is fine and stays fast/shared across that sandbox's
# own runs. Absent both signals -- the default, and every real host run --
# ~/.local/state is used instead: nothing under it is bound by any sandbox
# profile on this box (only ~/.local/bin and ~/.local/share/claude are,
# both read-only, neither this path), so a worker's write there never lands
# anywhere a host process will later read, and a host run never reads
# anywhere a worker could have written. Fails CLOSED: an environment this
# check cannot place is treated as a host run, not a sandboxed one.
if [ "${CC_WORKER_SANDBOX:-}" = 1 ] || [ "${CC_MEMBER_SANDBOX:-}" = 1 ]; then
  CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/chip-flow/shims"
else
  CACHE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/chip-flow/shims"
fi
mkdir -p "$CACHE_ROOT"
cache_key() {
  {
    realpath "$T" 2>/dev/null || echo "$T"
    [ -f "$T/.image-env.json" ] && cat "$T/.image-env.json"
    sha256sum "$EDA_SELF" 2>/dev/null
  } | sha256sum | cut -d' ' -f1
}
# SHIM_FINAL is where the cache will live once built, known up front and
# never anything else -- every wrap*/gcc_shims/etc function below embeds
# *this* path into the scripts it writes (an LD_PRELOAD value, a gcc -B
# flag), because that is where those scripts will actually be sitting when
# something execs them later. $SHIM is where those same functions physically
# write to *right now*, which on a cold cache is a private temp directory,
# not $SHIM_FINAL -- conflating the two was an earlier bug here: a wrapper
# built during a cold run had the temp build directory's own name baked
# into its LD_PRELOAD line, correct until the rename below made it stale.
SHIM_FINAL="$CACHE_ROOT/$(cache_key)"
SHIM="$SHIM_FINAL"
if [ ! -d "$SHIM_FINAL" ]; then
  SHIM="$(mktemp -d "$CACHE_ROOT/.build.XXXXXX")"
  populate_shim_cache_later=1
else
  populate_shim_cache_later=0
fi

# fakeexe_so -- compile (once per run, into $SHIM) a tiny LD_PRELOAD shared
# object and print its path. Running a target as `ld.so --library-path X
# target` (mandatory here -- see the header) never calls execve() on target
# itself, so the kernel never updates /proc/self/exe past ld.so's own path.
# Most of the tree doesn't care (magic/netgen/openroad key off env vars;
# $ORIGIN-relative RPATH is resolved by the dynamic linker's own bookkeeping,
# not /proc/self/exe) but yosys calls readlink("/proc/self/exe") itself to
# find its share/ directory, and fails outright without it. The preload
# below intercepts exactly that one readlink() and answers with whatever
# EDA_FAKE_SELF_EXE says, source-built with the image's own gcc rather than
# vendoring a prebuilt patchelf or similar into the repo.
FAKEEXE_SO=""
fakeexe_so() {
  [ -n "$FAKEEXE_SO" ] && { echo "$FAKEEXE_SO"; return; }
  # $so is where the .so is physically written *right now* (the cache, or a
  # cold-build temp dir); $so_final is the path embedded into any script
  # that references it, i.e. where it will be sitting once a cold build's
  # temp dir is renamed into place. The two differ only mid-build.
  local src="$SHIM/.fakeexe.c" so="$SHIM/.fakeexe.so" so_final="$SHIM_FINAL/.fakeexe.so"
  if [ -e "$so" ]; then
    # already built into the cache by an earlier eda run (or earlier in this
    # one's own build pass) -- the whole point of caching is not repeating
    # this compile on every single invocation.
    FAKEEXE_SO="$so_final"
    echo "$so_final"
    return
  fi
  cat > "$src" <<'EOF'
#define _GNU_SOURCE
#include <unistd.h>
#include <string.h>
#include <stdlib.h>
#include <dlfcn.h>
ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
    static ssize_t (*real_readlink)(const char *, char *, size_t) = 0;
    if (!real_readlink)
        real_readlink = (ssize_t (*)(const char *, char *, size_t))dlsym(RTLD_NEXT, "readlink");
    if (path && strcmp(path, "/proc/self/exe") == 0) {
        const char *fake = getenv("EDA_FAKE_SELF_EXE");
        if (fake) {
            size_t len = strlen(fake);
            if (len > bufsiz) len = bufsiz;
            memcpy(buf, fake, len);
            return (ssize_t)len;
        }
    }
    return real_readlink(path, buf, bufsiz);
}
EOF
  "$LD" --library-path "$BASE_LIBPATH" "$T/usr/bin/gcc-$GCC_VER" \
    -shared -fPIC -o "$so" "$src" -ldl >&2
  FAKEEXE_SO="$so_final"
  echo "$so_final"
}

# run_elf <real-absolute-path> [args...] -- exec an image ELF through the
# image's own loader, library path widened with the binary's own directory
# (several tools, e.g. klayout, keep their .so files next to the binary
# with an absolute, non-$ORIGIN RUNPATH that only resolves inside a real
# container -- adding dirname(bin) here covers that without needing a
# per-tool special case), with EDA_FAKE_SELF_EXE/LD_PRELOAD set so a tool
# that reads its own path via /proc/self/exe (see fakeexe_so above) sees the
# real one instead of ld.so's.
run_elf() {
  local bin="$1"; shift
  EDA_FAKE_SELF_EXE="$bin" LD_PRELOAD="$(fakeexe_so)" \
    exec "$LD" --library-path "$BASE_LIBPATH:$(dirname "$bin")" "$bin" "$@"
}

# run_py <script-path> [args...] -- bypass the script's own shebang (usually
# an absolute, host-wrong `#!/usr/bin/python3`) and hand it to the image's
# python3.12 directly, through the loader, with the image's site-packages
# on PYTHONPATH.
run_py() {
  local script="$1"; shift
  # PYTHONNOUSERSITE: without it, CPython still adds the HOST's user site
  # dir (~/.local/lib/python3.12/site-packages, PYTHONHOME notwithstanding
  # -- that lookup is keyed on $HOME, not PYTHONHOME) to sys.path. Any
  # package a host pip install ever put there would then shadow or clash
  # with the image's own, glibc-2.39-built dist-packages inside a run that
  # is supposed to be hermetic to the image.
  PYTHONNOUSERSITE=1 PYTHONPATH="${PYTHONPATH:-}${PYTHONPATH:+:}$PY_SITE" \
    exec "$LD" --library-path "$BASE_LIBPATH" "$PYBIN" "$script" "$@"
}

# wrap_at <dest-script-path> <real-absolute-path> -- write a loader-wrapping
# shell script at an exact path (used both for $SHIM/<name> and for the
# per-tool mirrors, e.g. verilator's). Carries the same /proc/self/exe fix
# as run_elf -- this is how it reaches something spawned by *name* rather
# than by eda's own top-level dispatch (e.g. yosys-abc, spawned by yosys).
wrap_at() {
  local dest="$1" real="$2" so
  so="$(fakeexe_so)"
  mkdir -p "$(dirname "$dest")"
  cat > "$dest" <<EOF
#!/bin/sh
export EDA_FAKE_SELF_EXE="$real"
export LD_PRELOAD="$so"
exec "$LD" --library-path "$BASE_LIBPATH:$(dirname "$real")" "$real" "\$@"
EOF
  chmod +x "$dest"
}

# wrap <name> <real-absolute-path> -- same, at $SHIM/<name>, for anything
# reached by a bare PATH lookup (a tool spawning another tool by name).
wrap() {
  wrap_at "$SHIM/$1" "$2"
}

# wrap_recurse <name> [eda-tool-name] -- a shim that just calls back into
# this same eda script (`eda <name> "$@"`), for a tool whose correct
# invocation is more than "exec one binary" (magic and netgen both need
# specific env plus extra flags, not just a loader wrapper) so the case
# dispatch below is the one place that logic lives, used whether eda was
# asked for the tool directly or something else found it by name on PATH.
#
# Recurses into $SHIM_FINAL/.eda -- a COPY of this script, written once by
# populate_shim_cache (below), never $EDA_SELF (this invocation's own
# checkout path). The cache key already hashes this script's content, so
# whichever checkout built a given cache entry is guaranteed byte-identical
# to any other checkout that would have produced the same key -- but
# $EDA_SELF is still that ONE checkout's path, and baking it into a shim
# that outlives this process is what let a later run of a DIFFERENT
# worktree (same content, same cache key) end up executing a shim that
# calls back into a worktree that may since have been removed, or have
# checked out a different branch entirely. Recursing into the cache's own
# copy instead makes the shim self-contained: it depends on nothing but the
# cache entry it already lives in.
wrap_recurse() {
  local name="$1" tool="${2:-$1}"
  mkdir -p "$SHIM"
  cat > "$SHIM/$name" <<EOF
#!/bin/sh
exec "$SHIM_FINAL/.eda" "$tool" "\$@"
EOF
  chmod +x "$SHIM/$name"
}

# wrap_iverilog_vvp -- shim both, the way the top-level iverilog/vvp cases
# do (see the comment there for why they need -B/-M and the extra lib dir).
# Needed wherever something else spawns them by name instead of eda being
# asked for them directly -- cocotb's runner does exactly that.
wrap_iverilog_vvp() {
  local so
  so="$(fakeexe_so)"
  cat > "$SHIM/iverilog" <<EOF
#!/bin/sh
export EDA_FAKE_SELF_EXE="$T/foss/tools/iverilog/bin/iverilog"
export LD_PRELOAD="$so"
exec "$LD" --library-path "$BASE_LIBPATH:$T/foss/tools/iverilog/lib" \\
  "$T/foss/tools/iverilog/bin/iverilog" -B"$T/foss/tools/iverilog/lib/ivl" "\$@"
EOF
  chmod +x "$SHIM/iverilog"
  cat > "$SHIM/vvp" <<EOF
#!/bin/sh
export EDA_FAKE_SELF_EXE="$T/foss/tools/iverilog/bin/vvp"
export LD_PRELOAD="$so"
exec "$LD" --library-path "$BASE_LIBPATH:$T/foss/tools/iverilog/lib" \\
  "$T/foss/tools/iverilog/bin/vvp" -M"$T/foss/tools/iverilog/lib/ivl" "\$@"
EOF
  chmod +x "$SHIM/vvp"
}

# wrap_py_at <dest-script-path> <real-script-path> -- a usr/local/bin style
# python console-script, reached by name, with the same shebang problem
# run_py solves for the top-level case.
wrap_py_at() {
  local dest="$1" real="$2"
  mkdir -p "$(dirname "$dest")"
  cat > "$dest" <<EOF
#!/bin/sh
export PYTHONPATH="$PY_SITE\${PYTHONPATH:+:\$PYTHONPATH}"
export PYTHONHOME="$PY_HOME"
export PYTHONNOUSERSITE=1
exec "$LD" --library-path "$BASE_LIBPATH" "$PYBIN" "$real" "\$@"
EOF
  chmod +x "$dest"
}
wrap_py() {
  wrap_py_at "$SHIM/$1" "$2"
}

# gcc_shims -- populate $SHIM with the four gcc subprograms plus binutils,
# and with gcc/g++ wrappers that inject -B$SHIM so gcc's own (PATH-blind)
# subprogram search lands on the wrapped copies. See header comment.
gcc_shims() {
  local gdir="$T/usr/libexec/gcc/x86_64-linux-gnu/$GCC_VER"
  local n
  for n in cc1 cc1plus lto1 collect2; do
    [ -e "$gdir/$n" ] && wrap "$n" "$gdir/$n"
  done
  for n in as ld ld.bfd ld.gold ld.mold mold ar nm ranlib strip objcopy ccache make; do
    [ -e "$T/usr/bin/$n" ] && wrap "$n" "$T/usr/bin/$n"
  done
  for n in gcc g++ cc c++ "gcc-$GCC_VER" "g++-$GCC_VER" cpp "cpp-$GCC_VER"; do
    local real="$T/usr/bin/$n"
    [ -e "$real" ] || continue
    cat > "$SHIM/$n" <<EOF
#!/bin/sh
exec "$LD" --library-path "$BASE_LIBPATH:$(dirname "$real")" "$real" -B"$SHIM_FINAL" "\$@"
EOF
    chmod +x "$SHIM/$n"
  done
}

# verilator_entry -- build the bin/share mirror described in the header and
# print the path of the copied `verilator` driver script to exec.
#
# `cover` (docs/design.md 1.5, "### M3.") is the first thing in this repo to
# need verilator_coverage - a SEPARATE perl driver from `verilator` itself,
# same shape (a perl script that locates its own real binary,
# verilator_coverage_bin_dbg, via $RealBin - FindBin - next to itself), not
# just a flag to the `verilator` driver. Mirrored into this same vroot/bin/
# for the same reason verilator_bin/verilator_bin_dbg are: whichever driver
# script actually runs must find its sibling real binary via $RealBin
# sitting right next to it, not in $T's read-only tree.
verilator_entry() {
  local vroot="$SHIM/.verilator-root"
  mkdir -p "$vroot/bin"
  cp "$T/foss/tools/verilator/bin/verilator" "$vroot/bin/verilator"
  chmod +x "$vroot/bin/verilator"
  wrap_at "$vroot/bin/verilator_bin" "$T/foss/tools/verilator/bin/verilator_bin"
  wrap_at "$vroot/bin/verilator_bin_dbg" "$T/foss/tools/verilator/bin/verilator_bin_dbg"
  cp "$T/foss/tools/verilator/bin/verilator_coverage" "$vroot/bin/verilator_coverage"
  chmod +x "$vroot/bin/verilator_coverage"
  wrap_at "$vroot/bin/verilator_coverage_bin_dbg" "$T/foss/tools/verilator/bin/verilator_coverage_bin_dbg"
  ln -sfn "$T/foss/tools/verilator/share" "$vroot/share"
  [ -d "$T/foss/tools/verilator/include" ] && ln -sfn "$T/foss/tools/verilator/include" "$vroot/include"
  echo "$vroot/bin/verilator"
}

# netgen_script <extra-tcl-commands-file-or-inline> -- write the stdin script
# that loads netgen's Tcl extension the way netgen.tcl would (its one
# /foss-prefixed `load` line, rewritten to $T) and defines the "lvs" etc.
# convenience procs, without running netgen.tcl's own wrapper/argv handling.
netgen_tcl_shim() {
  local patched="$SHIM/netgen.tcl"
  sed "s#/foss/#$T/foss/#g" "$T/foss/tools/netgen/lib/netgen/tcl/netgen.tcl" > "$patched"
  echo "$patched"
}

# populate_shim_cache -- build everything the cases below rely on finding
# already in $SHIM, once, on a cache miss. "python3" is here (not just the
# obviously-Python cases) for the same reason PYTHONHOME is exported
# globally above: yosys's *embedded* interpreter needs it to agree with a
# spawned one, and anything that spawns a plain "python3" subprocess
# (verilator's own build does, for a codegen step) needs to find our
# wrapper and not the host's, which PYTHONHOME would otherwise break.
populate_shim_cache() {
  # A copy, not a symlink, and not $EDA_SELF: see wrap_recurse's comment.
  # Written first so every wrap_recurse call below has it in place, though
  # none of them read it back until a shim they write is actually exec'd,
  # always after the atomic rename into $SHIM_FINAL further down.
  cp "$EDA_SELF" "$SHIM/.eda"
  chmod +x "$SHIM/.eda"
  wrap python3 "$PYBIN"
  wrap_iverilog_vvp
  wrap yosys "$T/foss/tools/yosys/bin/yosys"
  wrap yosys-abc "$T/foss/tools/yosys/bin/yosys-abc"
  for s in yices yices-sat yices-smt yices-smt2; do
    local real="$T/foss/tools/yosys/bin/$s"
    [ -e "$real" ] && wrap "$s" "$real"
  done
  gcc_shims
  verilator_entry >/dev/null
  netgen_tcl_shim >/dev/null
  # LibreLane's own flow drives magic, netgen, klayout, openroad, sta and
  # ruby all by bare name (see the librelane case below) -- built here,
  # once, into the atomic cache build, rather than on every `eda librelane`
  # run: the OLD code wrote these six directly into $SHIM from inside the
  # librelane case itself, which by then always equals $SHIM_FINAL (the
  # live, already-published cache, read by every concurrent `eda` on this
  # box) -- so every single librelane run rewrote six files in a directory
  # other processes could be reading mid-write, non-atomically, whether or
  # not the cache already existed. magic and netgen recurse back into this
  # same script (wrap_recurse) because their correct invocation is more
  # than "exec one binary"; that logic stays in one place, their own case
  # below, however they're reached.
  wrap_recurse magic
  wrap_recurse netgen
  wrap_recurse klayout
  wrap openroad "$T/foss/tools/openroad-librelane/bin/openroad"
  wrap sta "$T/foss/tools/openroad-librelane/bin/sta"
  # LibreLane's own klayout step doesn't only run `klayout -r <script>` --
  # for at least one check (XOR) it spawns "ruby" directly to run a
  # standalone .rb script outside klayout entirely.
  wrap ruby "$T/usr/bin/ruby3.2"
}

if [ "$populate_shim_cache_later" = "1" ]; then
  populate_shim_cache
  if mv -T "$SHIM" "$SHIM_FINAL" 2>/dev/null; then
    :
  else
    rm -rf "$SHIM"
  fi
  SHIM="$SHIM_FINAL"
fi
export PATH="$SHIM:$PATH"

case "$TOOL" in
  # ---- environment ----------------------------------------------------------
  check-env)
    run_py "$CHECK_ENV_PY" "$@"
    ;;

  # ---- digital sim / lint -------------------------------------------------
  # iverilog/vvp both have a *compiled-in* absolute /foss/tools/iverilog/lib
  # module-search prefix (not argv0-relative like most of the tree, and not
  # exposed as an env var) -- iverilog takes it as -B<dir>, vvp as -M<dir>;
  # vvp also needs iverilog's lib/ dir on the library path for libvvp.so.1,
  # which lives there rather than under the usual lib/x86_64-linux-gnu.
  iverilog|vvp)
    exec "$SHIM/$TOOL" "$@"
    ;;

  iverilog-vpi|ghdl|verible*|slang|nvc)
    real="$T/foss/tools/${TOOL%%-*}/bin/$TOOL"
    [ -e "$real" ] || real="$T/foss/tools/iverilog/bin/$TOOL"
    run_elf "$real" "$@"
    ;;

  # gtkwave's fst2vcd needs libfst.so.1 from gtkwave's own lib dir, which is
  # not on BASE_LIBPATH. optimise.py's power metric converts cocotb's FST
  # dump with it, because OpenSTA's read_vcd reads VCD only.
  fst2vcd)
    real="$T/foss/tools/gtkwave/bin/fst2vcd"
    exec "$LD" --library-path "$BASE_LIBPATH:$T/foss/tools/gtkwave/lib/x86_64-linux-gnu" \
      "$real" "$@"
    ;;

  verilator|verilator_coverage|verilator_gantt)
    # verilator_coverage is its own perl driver (verilator_entry's own
    # comment) - always execing the `verilator` entry here for it used to
    # hand verilator_coverage's own args (e.g. `--write-info`) to the
    # COMPILER driver instead, which rejects them as unknown options.
    # verilator_gantt has no dbg-binary sibling of its own to mirror (it is
    # a plain python script - see verilator_entry) so it still runs via the
    # `verilator` entry's PATH/VERILATOR_ROOT setup, unchanged.
    case "$TOOL" in
      verilator_coverage) entry="$SHIM/.verilator-root/bin/verilator_coverage" ;;
      *) entry="$SHIM/.verilator-root/bin/verilator" ;;
    esac
    export PATH="$SHIM:$SHIM/.verilator-root/bin:$PATH"
    export VERILATOR_ROOT="$T/foss/tools/verilator/share/verilator"
    exec "$entry" "$@"
    ;;

  # ---- synthesis / formal --------------------------------------------------
  yosys)
    run_elf "$T/foss/tools/yosys/bin/yosys" "$@"
    ;;

  # sby and yosys-smtbmc are `#!/usr/bin/env python3` scripts (no absolute-
  # shebang problem), so they're run from their real location, left to find
  # "python3" via PATH like they would in the real container -- yosys and
  # the solvers they spawn by name (yices is the one this image ships;
  # smtbmc's own --solver default already happens to be yices) are shimmed
  # once into the cache, not here.
  sby|yosys-smtbmc|yosys-config|yosys-filterlib|yosys-witness)
    export PATH="$SHIM:$T/foss/tools/yosys/bin:$PATH"
    export PYTHONPATH="$PY_SITE${PYTHONPATH:+:$PYTHONPATH}"
    exec "$T/foss/tools/yosys/bin/$TOOL" "$@"
    ;;

  # ---- cocotb / python -----------------------------------------------------
  # `cover` (docs/design.md 1.5, "### M3.") drives cocotb over the VERILATOR
  # simulator, not Icarus - cocotb_tools.runner.get_runner("verilator")
  # resolves "verilator" with a bare PATH lookup from inside this very
  # python process, the same way LibreLane's own flow does (the `librelane`
  # case below carries the identical two exports) - without them the
  # verilator driver script (only ever mirrored into $SHIM/.verilator-root,
  # never $SHIM itself - see verilator_entry's comment) is not on PATH and
  # "verilator executable not found" fails before a single line of the
  # script runs.
  python3|python)
    export PATH="$SHIM:$SHIM/.verilator-root/bin:$PATH"
    export VERILATOR_ROOT="$T/foss/tools/verilator/share/verilator"
    run_py "$@"
    ;;

  # ---- analog --------------------------------------------------------------
  ngspice|ngspice_con)
    run_elf "$T/foss/tools/ngspice/bin/ngspice" "$@"
    ;;

  # ---- layout / DRC / LVS ---------------------------------------------------
  klayout)
    # klayout's Qt Network/Multimedia modules pull in two plugin .so's kept
    # outside the usual lib dir (a proxy backend, a pulseaudio backend);
    # neither is used headless, but both are hard NEEDED entries. Batch mode
    # (-b) matters too: without it klayout tries to open a GUI/X11 session
    # and this box has none to open, so it just hangs. klayout's *embedded*
    # Ruby (used by every .drc/.lydrc deck, including gf180mcu's) needs its
    # own stdlib pointed at explicitly too -- without RUBYLIB even klayout's
    # own built-in DRC engine macro fails to `require 'pathname'` and DRC
    # decks die with a half-constructed DRCEngine object.
    export RUBYLIB="$T/usr/lib/ruby/3.2.0:$T/usr/lib/x86_64-linux-gnu/ruby/3.2.0"
    EDA_FAKE_SELF_EXE="$T/foss/tools/klayout/klayout" LD_PRELOAD="$(fakeexe_so)" \
    exec "$LD" --library-path "$BASE_LIBPATH:$T/foss/tools/klayout:$T/usr/lib/x86_64-linux-gnu/libproxy:$T/usr/lib/x86_64-linux-gnu/pulseaudio" \
      "$T/foss/tools/klayout/klayout" "$@"
    ;;

  # magic's own C-level bootstrap always loads a technology named exactly
  # "minimum" first, unconditionally -- true even with -T, even with the
  # PDK's tech file sitting right next to it. -T just names one of magic's
  # *own* bundled techs to switch to afterward (scmos, minimum, ...), so it
  # can't be used to select a PDK tech directly. That was the whole
  # earlier problem: an image whose magic/sys had been dropped had no
  # "minimum" to find, so the bootstrap died before any script ran. It's
  # back now, so the fix is to route the PDK's own tech through the
  # channel magic actually reads *during* that bootstrap: -rcfile,
  # processed by magic.tcl before the "minimum" load ever happens, so
  # "minimum" itself is never loaded, and scratch structures sized during
  # bootstrap (a DRC yank buffer among them) are sized for the real PDK
  # tech from the start. Loading them for "minimum" and switching
  # technology afterward via `tech load` leaves those undersized -- that
  # is what a `gds read` under the real tech used to segfault on
  # (DBBoundPlane on a NULL plane, confirmed under gdb). CAD_ROOT has to
  # be set for magic.tcl's own sibling-file lookups (wrapper.tcl etc.) to
  # resolve; magic/tcl sits under lib/magic/tcl, not tcl/ directly.
  magic)
    export TCL_LIBRARY="$T/usr/share/tcltk/tcl8.6"
    export CAD_ROOT="$T/foss/tools/magic/lib"
    export PDK_ROOT="${PDK_ROOT:-$T/foss/pdks}"
    run_elf "$T/foss/tools/magic/lib/magic/tcl/magicdnull" -dnull -noconsole \
      -rcfile "$PDK_ROOT/gf180mcuD/libs.tech/magic/gf180mcuD.magicrc" "$@"
    ;;

  netgen)
    export TCL_LIBRARY="$T/usr/share/tcltk/tcl8.6"
    export PDK_ROOT="${PDK_ROOT:-$T/foss/pdks}"
    patched="$SHIM/netgen.tcl"
    if [ "${1:-}" = "-batch" ]; then
      shift
      { echo "source $patched"; echo "$*"; echo "::netgen::quit"; } \
        | run_elf "$T/foss/tools/netgen/lib/netgen/tcl/netgenexec" --
    else
      { echo "source $patched"; cat; } \
        | run_elf "$T/foss/tools/netgen/lib/netgen/tcl/netgenexec" -- "$@"
    fi
    ;;

  # ---- timing / place-and-route ---------------------------------------------
  openroad|sta)
    export TCL_LIBRARY="$T/usr/share/tcltk/tcl8.6"
    run_elf "$T/foss/tools/openroad/bin/$TOOL" "$@"
    ;;

  librelane)
    # Best effort: LibreLane's default flow drives yosys, verilator (lint),
    # openroad/sta, klayout and (magic or netgen for DRC/LVS) all by bare
    # name. Every one of those shims (magic and netgen recursing back into
    # this same script, klayout too, openroad/sta/ruby as plain loader
    # wrappers) is built once, atomically, in populate_shim_cache -- never
    # here, so a librelane run only ever READS the cache, never writes it.
    export PATH="$SHIM:$SHIM/.verilator-root/bin:$T/foss/tools/openroad-librelane/bin:$PATH"
    export VERILATOR_ROOT="$T/foss/tools/verilator/share/verilator"
    export TOOLS="$T/foss/tools"
    export PDK_ROOT="${PDK_ROOT:-$T/foss/pdks}"
    export TCL_LIBRARY="$T/usr/share/tcltk/tcl8.6"
    export RUBYLIB="$T/usr/lib/ruby/3.2.0:$T/usr/lib/x86_64-linux-gnu/ruby/3.2.0"
    run_py "$T/usr/local/bin/librelane" --manual-pdk "$@"
    ;;

  # ---- generic fallback ------------------------------------------------------
  *)
    real=""
    for cand in \
      "$T/foss/tools/$TOOL/bin/$TOOL" \
      "$T/foss/tools/$TOOL/$TOOL" \
      "$T/foss/tools/bin/$TOOL" \
      "$T/usr/local/bin/$TOOL" \
      "$T/usr/bin/$TOOL"
    do
      if [ -e "$cand" ] && [ ! -L "$cand" ]; then real="$cand"; break; fi
      if [ -L "$cand" ]; then
        tgt="$(readlink -f "$cand" 2>/dev/null || true)"
        # a symlink inside the tree resolving to /foss/... is one of the
        # image's own (broken-on-host) absolute symlinks; re-root it at $T.
        case "$tgt" in
          /foss/*) real="$T$tgt" ;;
          "$T"/*) real="$tgt" ;;
        esac
        [ -n "$real" ] && [ -e "$real" ] && break
        real=""
      fi
    done
    if [ -z "$real" ]; then
      echo "eda: don't know how to run '$TOOL' (not found under $T)" >&2
      exit 1
    fi
    first2="$(head -c2 "$real" 2>/dev/null || true)"
    if [ "$first2" = "#!" ]; then
      shebang="$(head -n1 "$real")"
      case "$shebang" in
        *python3*|*python*)
          run_py "$real" "$@"
          ;;
        *)
          export PATH="$SHIM:$PATH"
          exec "$real" "$@"
          ;;
      esac
    else
      run_elf "$real" "$@"
    fi
    ;;
esac
