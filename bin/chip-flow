#!/bin/sh
# chip-flow inside the Hive: points the skills' engine at this module
# (CHIP_FLOW_HOME) and bin/eda at the Hive's IIC-OSIC-TOOLS tree
# (EDA_TOOLCHAIN), then runs what's asked through bin/eda.
#
#   chip-flow env              print the exports (eval "$(chip-flow env)")
#   chip-flow check            eda check-env: every tool the gates need
#   chip-flow test             the per-change test: the engine's fast tests
#                              (upstream's tests/check-engine.sh, with the
#                              workaround probes), then every corpus rung's
#                              planted faults that need no harden, each
#                              caught by its gate
#   chip-flow check-all        re-run every block's gates from a scratch
#                              copy into the step cache, and check
#                              docs/workarounds.md against its probes (slow:
#                              hardens included); --stale only what no run
#                              covers, --budget S stops at S seconds
#   chip-flow score            how much of the known blocks (blocks/known.json)
#                              passes every gate in the Hive, plus the share
#                              of planted faults caught and check-all's
#                              speed: the score. It first runs check-all
#                              --stale to the end, then the corpus rungs a
#                              change staled (within $CHIP_FLOW_SCORE_FAULT_BUDGET
#                              seconds, 1500), then reads the caches;
#                              --no-run reads only
#   chip-flow eda <tool> ...   bin/eda: any tool from the tree (ngspice,
#                              xschem, magic, netgen, klayout, yosys, ...)
#   chip-flow <script> [args]  engine/scripts/<script>.py with the tree's
#                              python (gate, state, task_router, faults, ...)
#
# Nothing here installs anything: the tree is the Hive's, read-only (put
# there through a warden), and bin/eda keeps its shims under HOME.
set -e
here=$(cd "$(dirname "$0")/.." && pwd)

# The score with --no-run reads and hashes files only: no toolchain.
if [ "${1:-}" = score ] && [ "${2:-}" = --no-run ]; then
	CHIP_FLOW_SCORE_FAULT_BUDGET=0 exec python3 "$here/bin/score.py"
fi

# The tree: an explicit pin wins; else the newest IIC-OSIC-TOOLS tree in the
# Hive's tools folder, then in /opt/eda-toolchain, where H0 keeps it.
if [ -z "${EDA_TOOLCHAIN:-}" ]; then
	for d in "${HIVE_TOOLS:-/hive/tools}" /opt/eda-toolchain; do
		t=$(ls -d "$d"/iic-osic-tools-* 2>/dev/null | sort -V | tail -n 1)
		[ -n "$t" ] && { EDA_TOOLCHAIN=$t; break; }
	done
fi
if [ "${1:-}" = score ] && { [ -z "${EDA_TOOLCHAIN:-}" ] || [ ! -d "$EDA_TOOLCHAIN" ]; }; then
	# nothing can run: what no run covers stays not clean
	echo "chip-flow score: no IIC-OSIC-TOOLS tree, so no gate runs; reading the caches and seeds only" >&2
	CHIP_FLOW_SCORE_FAULT_BUDGET=0 exec python3 "$here/bin/score.py"
fi
if [ -z "${EDA_TOOLCHAIN:-}" ] || [ ! -d "$EDA_TOOLCHAIN" ]; then
	echo "chip-flow: no IIC-OSIC-TOOLS tree (looked in ${HIVE_TOOLS:-/hive/tools} and /opt/eda-toolchain); ask a warden, or set EDA_TOOLCHAIN" >&2
	exit 127
fi
CHIP_FLOW_HOME=$here
export EDA_TOOLCHAIN CHIP_FLOW_HOME
eda=$here/bin/eda

case "${1:-}" in
env)
	printf "export EDA_TOOLCHAIN='%s'\nexport CHIP_FLOW_HOME='%s'\n" "$EDA_TOOLCHAIN" "$CHIP_FLOW_HOME"
	;;
check)
	shift
	exec "$eda" check-env "$@"
	;;
test)
	# Upstream's engine suite without its real-tool (slow) tests, under its
	# own CPU budget; it collects tests/test_workarounds.py, the probes, too.
	# Then the planted faults: each rung's untouched reference passes the
	# gates its faults/manifest.yaml names and each plant is caught by its
	# gate (tests/test_corpus_faults.py, real tools, under its own cap); the
	# rungs that harden stay in tests/check-harden-faults.sh, too slow here.
	#
	# Both run with their scratch in memory and fsync off
	# (tests/lib/scratch.sh says how and why).
	# shellcheck source=tests/lib/scratch.sh
	. "$here/tests/lib/scratch.sh"
	test_scratch
	if [ -n "$TEST_SCRATCH" ]; then trap 'rm -rf "$TEST_SCRATCH"' EXIT; fi
	cd "$here"
	bash tests/check-engine.sh
	timeout 1200 "$eda" python -m pytest -q -p no:cacheprovider \
		tests/test_corpus_faults.py -m "slow and not harden_faults"
	;;
check-all)
	shift
	exec "$eda" python "$here/bin/check_all.py" "$@"
	;;
score)
	# Runs what the cache and the seeds don't cover, fewest steps first, to
	# the end: a stale known block is scored on its gates, not on whether
	# the score had time for them. A run the Hive's check cuts off leaves
	# every step it finished in the cache, so the next try (given twice
	# the time) runs only what is still uncovered; a step that never ran
	# is not clean. CHIP_FLOW_SCORE_STEP_BUDGET caps it where wanted.
	# Its outcome doesn't decide the score, so its exit doesn't either.
	# The planted-fault rungs (score_faults.py) then get their own budget.
	"$eda" python "$here/bin/check_all.py" --stale --no-probes \
		${CHIP_FLOW_SCORE_STEP_BUDGET:+--budget "$CHIP_FLOW_SCORE_STEP_BUDGET"} >&2 || true
	CHIP_FLOW_SCORE_FAULT_BUDGET=${CHIP_FLOW_SCORE_FAULT_BUDGET:-1500} \
		exec python3 "$here/bin/score.py"
	;;
eda)
	shift
	exec "$eda" "$@"
	;;
"" | -h | --help)
	sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
	;;
*)
	s=$1
	shift
	exec "$eda" python "$here/engine/scripts/${s%.py}.py" "$@"
	;;
esac
